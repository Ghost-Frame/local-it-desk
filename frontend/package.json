{
  "name": "local-it-desk-frontend",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "check": "pnpm typecheck && pnpm test:node && pnpm build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:node": "tsc -p tsconfig.test.json && node --test .node-test-build/tests/**/*.test.js"
  },
  "dependencies": {
    "@vueuse/core": "^13.1.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.34",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.3.1"
  }
}
