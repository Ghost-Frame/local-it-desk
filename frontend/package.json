{
  "name": "local-it-desk-frontend",
  "private": true,
  "version": "0.2.1",
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "check": "pnpm typecheck && pnpm test:node && pnpm build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:node": "node node_modules/@typescript/native/bin/tsc -p tsconfig.test.json && node --test .node-test-build/tests/**/*.test.js"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "pinia": "^3.0.4",
    "qrcode": "1.5.4",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.9"
  }
}
