{
	admin off
	auto_https off
}

http://127.0.0.1:8080 {
	reverse_proxy app:3000
}

:8443 {
	tls /certs/tls.crt /certs/tls.key
	encode zstd gzip
	header {
		-X-Powered-By
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
	reverse_proxy app:3000
}
