# Versioned application image. Replace only during a documented update.
LOCAL_IT_DESK_IMAGE=local-it-desk:0.1.1

# Evaluation-only HTTP listener. Keep real staff credentials off this profile.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080
APP_ORIGIN=http://localhost:8080

# School HTTPS listener and browser origin.
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
HTTPS_ORIGIN=https://helpdesk.local

# Runtime branding and optional help contact. These values are not credentials.
APP_NAME=Local IT Desk
SUPPORT_CONTACT=

# Session duration and bounded upload or roster limits.
SESSION_TTL_DAYS=14
MAX_UPLOAD_BYTES=26214400
MAX_TICKET_UPLOAD_BYTES=104857600
MAX_ROSTER_BYTES=1048576
MAX_ROSTER_ROWS=500

# Server log verbosity. The Compose logging driver also rotates stored logs.
RUST_LOG=info
